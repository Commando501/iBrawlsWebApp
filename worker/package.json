{
  "name": "ibrawls-backend",
  "version": "1.0.0",
  "description": "iBrawls multiplayer matchmaking and relay server running on Cloudflare Workers and Durable Objects",
  "main": "src/index.ts",
  "scripts": {
    "dev": "wrangler dev",
    "typecheck": "tsc --noEmit",
    "deploy": "wrangler deploy",
    "db:create": "wrangler d1 create ibrawls",
    "db:migrate:local": "wrangler d1 migrations apply ibrawls --local",
    "db:migrate": "wrangler d1 migrations apply ibrawls --remote"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20240320.0",
    "typescript": "^5.3.3",
    "wrangler": "^3.35.0"
  }
}
